{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-build",
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", ".next", "out", "dist", "electron-app"]
}
