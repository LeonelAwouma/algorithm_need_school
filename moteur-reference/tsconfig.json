{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".test-build"
  },
  "include": ["lib/**/*.ts", "types/**/*.ts", "tests/**/*.ts"]
}
